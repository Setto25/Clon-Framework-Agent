# {{NOMBRE_PROYECTO}} — Variables de entorno
# Copiar a .env y completar con valores reales.
# NUNCA commitear .env — solo .env.ejemplo va al repositorio.

# --- Base de datos ---
DATABASE_URL=postgresql://usuario:contraseña@localhost:5432/{{IDENTIFICADOR_PROYECTO}}_dev

# --- API Keys (rellenar con valores reales) ---
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GEMINI_API_KEY=...

# --- Servidor ---
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
ENVIRONMENT=development

# --- Proyecto ---
PROJECT_NAME={{NOMBRE_PROYECTO_ENV}}
LOG_LEVEL=DEBUG
